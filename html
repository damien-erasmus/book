<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For the One Who Is My Inevitable</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --rose-gold: #c9a07a;
    --rose-light: #e8c4b8;
    --blush: #f2d4d0;
    --silver: #d4d8e8;
    --silver-bright: #eef0f8;
    --midnight: #0d0a1a;
    --deep-purple: #1a1230;
    --mid-purple: #2d1f4e;
    --glow-pink: rgba(220, 140, 160, 0.6);
    --glow-gold: rgba(201, 160, 122, 0.5);
  }

  html { scroll-behavior: smooth; }

  body {
    min-height: 100vh;
    background: var(--midnight);
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--silver-bright);
    overflow-x: hidden;
    cursor: default;
  }

  /* ── Animated gradient background ── */
  .bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 20% 20%, rgba(80, 30, 80, 0.5) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 80%, rgba(60, 15, 50, 0.6) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 50%, rgba(30, 10, 60, 0.8) 0%, transparent 70%),
      linear-gradient(160deg, #0d0a1a 0%, #1a1230 40%, #0f0820 70%, #0d0a1a 100%);
    animation: bgShift 12s ease-in-out infinite alternate;
  }
  @keyframes bgShift {
    0%   { filter: hue-rotate(0deg) brightness(1); }
    50%  { filter: hue-rotate(12deg) brightness(1.08); }
    100% { filter: hue-rotate(-8deg) brightness(0.95); }
  }

  /* ── Static star field ── */
  .star-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: white;
    animation: twinkle var(--dur, 3s) ease-in-out infinite alternate;
    opacity: var(--op, 0.4);
  }
  @keyframes twinkle {
    from { opacity: var(--op, 0.4); transform: scale(1); }
    to   { opacity: calc(var(--op, 0.4) * 0.2); transform: scale(0.5); }
  }

  /* ── Page wrapper ── */
  .page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem 5rem;
    gap: 0;
  }

  /* ── Decorative top ornament ── */
  .ornament {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(1rem, 3vw, 1.3rem);
    color: var(--rose-gold);
    letter-spacing: 0.25em;
    opacity: 0.75;
    margin-bottom: 1.5rem;
    animation: floatSlow 6s ease-in-out infinite alternate;
  }

  /* ── Hero heading ── */
  .hero-eyebrow {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(0.75rem, 2vw, 0.9rem);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--rose-gold);
    opacity: 0.8;
    margin-bottom: 0.8rem;
    animation: floatSlow 5s ease-in-out infinite alternate;
  }

  .hero-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 6vw, 3.8rem);
    font-style: italic;
    font-weight: 400;
    color: var(--silver-bright);
    text-align: center;
    line-height: 1.25;
    max-width: 680px;
    margin-bottom: 0.5rem;
    animation: floatSlow 7s ease-in-out infinite alternate;
    text-shadow: 0 0 40px rgba(201, 160, 122, 0.3), 0 0 80px rgba(180, 100, 140, 0.15);
  }

  .hero-sub {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(0.9rem, 2.5vw, 1.15rem);
    color: var(--rose-light);
    opacity: 0.7;
    text-align: center;
    letter-spacing: 0.08em;
    margin-bottom: 3rem;
    font-style: italic;
    animation: floatSlow 8s ease-in-out infinite alternate;
  }

  @keyframes floatSlow {
    from { transform: translateY(0px); }
    to   { transform: translateY(-6px); }
  }

  /* ── Divider ── */
  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
    width: min(320px, 80%);
    opacity: 0.5;
  }
  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--rose-gold), transparent);
  }
  .divider-gem {
    width: 6px; height: 6px;
    background: var(--rose-gold);
    transform: rotate(45deg);
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--rose-gold);
  }

  /* ── Heart container ── */
  .heart-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.5rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* Glow ring behind heart */
  .heart-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(220, 100, 140, 0.18) 0%, rgba(201, 160, 122, 0.08) 50%, transparent 75%);
    animation: glowPulse 3s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes glowPulse {
    0%, 100% { transform: scale(1); opacity: 0.7; }
    50%       { transform: scale(1.18); opacity: 1; }
  }

  /* The SVG heart */
  .heart-svg {
    position: relative;
    width: clamp(100px, 22vw, 140px);
    height: clamp(100px, 22vw, 140px);
    filter: drop-shadow(0 0 18px rgba(220, 100, 140, 0.55)) drop-shadow(0 0 40px rgba(201, 160, 122, 0.3));
    animation: heartbeat 2.2s ease-in-out infinite;
    transition: filter 0.3s ease;
  }
  .heart-wrap:hover .heart-svg {
    filter: drop-shadow(0 0 28px rgba(220, 100, 140, 0.8)) drop-shadow(0 0 60px rgba(201, 160, 122, 0.5));
  }
  @keyframes heartbeat {
    0%   { transform: scale(1); }
    14%  { transform: scale(1.08); }
    28%  { transform: scale(1); }
    42%  { transform: scale(1.05); }
    70%  { transform: scale(1); }
    100% { transform: scale(1); }
  }

  .heart-svg.clicked {
    animation: heartClick 0.5s ease-out forwards, heartbeat 2.2s ease-in-out 0.5s infinite;
  }
  @keyframes heartClick {
    0%   { transform: scale(1); }
    30%  { transform: scale(1.35); }
    60%  { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  /* Click hint text */
  .click-hint {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(0.7rem, 2vw, 0.8rem);
    color: var(--rose-gold);
    opacity: 0.55;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-align: center;
    margin-top: -0.5rem;
    margin-bottom: 2.5rem;
    animation: blink 3s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 0.55; }
    50%       { opacity: 0.2; }
  }

  /* ── Quote box ── */
  .quote-wrap {
    max-width: 580px;
    width: 100%;
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 2.5rem;
    position: relative;
    text-align: center;
    margin-bottom: 3rem;
  }

  .quote-wrap::before, .quote-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2px;
    pointer-events: none;
  }
  .quote-wrap::before {
    border-top: 1px solid rgba(201, 160, 122, 0.25);
    border-bottom: 1px solid rgba(201, 160, 122, 0.25);
  }
  .quote-wrap::after {
    border-left: 1px solid rgba(201, 160, 122, 0.12);
    border-right: 1px solid rgba(201, 160, 122, 0.12);
  }

  .quote-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(1rem, 3vw, 1.25rem);
    color: var(--silver-bright);
    line-height: 1.7;
    letter-spacing: 0.02em;
    text-shadow: 0 0 30px rgba(201, 160, 122, 0.2);
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
    transform: translateY(10px);
  }
  .quote-text.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .quote-text.fade-out {
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .quote-attribution {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    color: var(--rose-gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 1rem;
    opacity: 0;
    transition: opacity 0.8s ease 0.3s;
  }
  .quote-attribution.visible { opacity: 0.65; }
  .quote-attribution.fade-out { opacity: 0; transition: opacity 0.3s ease; }

  /* ── Bottom ornamental text ── */
  .footer-verse {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(1.2rem, 4vw, 1.8rem);
    color: var(--rose-gold);
    text-align: center;
    opacity: 0.6;
    animation: floatSlow 9s ease-in-out infinite alternate;
    margin-bottom: 0.5rem;
  }
  .footer-tiny {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.72rem;
    color: var(--silver);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.3;
    text-align: center;
  }

  /* ── Particle canvas ── */
  #particle-canvas {
    position: fixed;
    inset: 0;
    z-index: 999;
    pointer-events: none;
  }

  /* ── Responsive tweaks ── */
  @media (max-width: 480px) {
    .page { padding: 2rem 1rem 4rem; }
    .quote-wrap { padding: 1.5rem 1.25rem; }
  }
</style>
</head>
<body>

<div class="bg-canvas"></div>
<div class="star-field" id="starField"></div>
<canvas id="particle-canvas"></canvas>

<div class="page">

  <div class="ornament">✦ &nbsp; Powerless &nbsp;·&nbsp; Reckless &nbsp;·&nbsp; Fearless &nbsp; ✦</div>

  <p class="hero-eyebrow">A message for you</p>

  <h1 class="hero-heading">"For the one who is my inevitable..."</h1>

  <p class="hero-sub">In life and in death &mdash; always.</p>

  <div class="divider">
    <div class="divider-line"></div>
    <div class="divider-gem"></div>
    <div class="divider-line"></div>
  </div>

  <div class="heart-wrap" id="heartWrap" role="button" aria-label="Click to reveal a quote" tabindex="0">
    <div class="heart-glow"></div>
    <svg class="heart-svg" id="heartSvg" viewBox="0 0 100 90" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="hg" cx="50%" cy="35%" r="65%">
          <stop offset="0%"   stop-color="#f0a0b8"/>
          <stop offset="40%"  stop-color="#d0607a"/>
          <stop offset="75%"  stop-color="#a03050"/>
          <stop offset="100%" stop-color="#6a1530"/>
        </radialGradient>
        <radialGradient id="hgShine" cx="35%" cy="25%" r="35%">
          <stop offset="0%"  stop-color="rgba(255,230,235,0.65)"/>
          <stop offset="100%" stop-color="rgba(255,200,220,0)"/>
        </radialGradient>
      </defs>
      <path d="M50 85 C50 85 5 55 5 28 C5 14 16 5 28 5 C36 5 44 9 50 16 C56 9 64 5 72 5 C84 5 95 14 95 28 C95 55 50 85 50 85 Z"
            fill="url(#hg)" stroke="rgba(200,80,110,0.4)" stroke-width="0.5"/>
      <path d="M50 85 C50 85 5 55 5 28 C5 14 16 5 28 5 C36 5 44 9 50 16 C56 9 64 5 72 5 C84 5 95 14 95 28 C95 55 50 85 50 85 Z"
            fill="url(#hgShine)"/>
    </svg>
  </div>

  <p class="click-hint">touch to awaken</p>

  <div class="quote-wrap" id="quoteWrap">
    <div>
      <p class="quote-text" id="quoteText"></p>
      <p class="quote-attribution" id="quoteAttr">— Lauren Roberts</p>
    </div>
  </div>

  <div class="divider">
    <div class="divider-line"></div>
    <div class="divider-gem"></div>
    <div class="divider-line"></div>
  </div>

  <p class="footer-verse">You are my inevitable</p>
  <p class="footer-tiny">✦ &nbsp; Inspired by The Powerless Trilogy &nbsp; ✦</p>

</div>

<script>
(function () {
  /* ── Star field ── */
  const sf = document.getElementById('starField');
  const starCount = 120;
  for (let i = 0; i < starCount; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random() * 2.5 + 0.5;
    s.style.cssText = `
      width:${size}px; height:${size}px;
      left:${Math.random()*100}%;
      top:${Math.random()*100}%;
      --dur:${(Math.random()*4+2).toFixed(1)}s;
      --op:${(Math.random()*0.6+0.1).toFixed(2)};
      animation-delay:${(Math.random()*5).toFixed(1)}s;
    `;
    sf.appendChild(s);
  }

  /* ── Quotes ── */
  const quotes = [
    "I'd never thought about what my favourite color was before. Not until I looked into your eyes and realized that perhaps drowning was a beautiful thing.",
    "You don't need a blade. I would bleed if only you asked.",
    "You are my inevitable. In life and in death.",
    '"What do you want to call me?" — "I want to call you mine."',
    "I have never had to pretend to want you, darling.",
    "Every girl deserves something equally as pretty and deadly as they are."
  ];
  let quoteIndex = -1;
  const quoteText = document.getElementById('quoteText');
  const quoteAttr = document.getElementById('quoteAttr');

  function showNextQuote() {
    quoteIndex = (quoteIndex + 1) % quotes.length;
    quoteText.classList.remove('visible');
    quoteAttr.classList.remove('visible');
    quoteText.classList.add('fade-out');
    quoteAttr.classList.add('fade-out');

    setTimeout(() => {
      quoteText.classList.remove('fade-out');
      quoteAttr.classList.remove('fade-out');
      quoteText.textContent = quotes[quoteIndex];
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          quoteText.classList.add('visible');
          quoteAttr.classList.add('visible');
        });
      });
    }, 420);
  }

  /* ── Particle engine ── */
  const canvas = document.getElementById('particle-canvas');
  const ctx = canvas.getContext('2d');
  let W, H;
  const particles = [];

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const COLORS = [
    '#f9d4df','#e8a0b4','#c96090','#dda070','#c9a07a',
    '#e8c4b8','#f0e0e8','#ffffff','#ffd6e0','#b0a0d8',
    '#e0d0f8','#f8f0ff'
  ];

  function rnd(a, b) { return a + Math.random() * (b - a); }

  class Particle {
    constructor(x, y) {
      this.x = x; this.y = y;
      const angle = rnd(0, Math.PI * 2);
      const speed = rnd(1.5, 8);
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed - rnd(1, 3);
      this.life = 1;
      this.decay = rnd(0.012, 0.032);
      this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
      this.type = Math.random();
      this.size = rnd(2, 6);
      this.rotation = rnd(0, Math.PI * 2);
      this.rotSpeed = rnd(-0.12, 0.12);
      this.gravity = rnd(0.05, 0.15);
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      this.vy += this.gravity;
      this.vx *= 0.985;
      this.life -= this.decay;
      this.rotation += this.rotSpeed;
    }

    draw(c) {
      c.save();
      c.globalAlpha = Math.max(0, this.life);
      c.translate(this.x, this.y);
      c.rotate(this.rotation);
      c.fillStyle = this.color;
      c.shadowBlur = 8;
      c.shadowColor = this.color;

      if (this.type < 0.3) {
        /* tiny heart */
        const s = this.size * 0.7;
        c.beginPath();
        c.moveTo(0, s * 0.35);
        c.bezierCurveTo(-s, -s * 0.4, -s * 1.8, s * 0.4, 0, s * 1.5);
        c.bezierCurveTo(s * 1.8, s * 0.4, s, -s * 0.4, 0, s * 0.35);
        c.fill();
      } else if (this.type < 0.6) {
        /* 4-point star */
        const s = this.size;
        c.beginPath();
        for (let i = 0; i < 8; i++) {
          const r = i % 2 === 0 ? s : s * 0.4;
          const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
          i === 0 ? c.moveTo(Math.cos(a)*r, Math.sin(a)*r)
                  : c.lineTo(Math.cos(a)*r, Math.sin(a)*r);
        }
        c.closePath();
        c.fill();
      } else {
        /* circle ember */
        c.beginPath();
        c.arc(0, 0, this.size * 0.55, 0, Math.PI * 2);
        c.fill();
      }
      c.restore();
    }
  }

  /* Large burst ring */
  class RingBurst {
    constructor(x, y) {
      this.x = x; this.y = y;
      this.r = 0; this.life = 1;
    }
    update() {
      this.r += 12;
      this.life -= 0.04;
    }
    draw(c) {
      if (this.life <= 0) return;
      c.save();
      c.globalAlpha = this.life * 0.35;
      c.beginPath();
      c.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      c.strokeStyle = '#e8c4b8';
      c.lineWidth = 1.5;
      c.stroke();
      c.restore();
    }
  }

  const rings = [];

  function burst(x, y) {
    const count = window.innerWidth < 600 ? 55 : 90;
    for (let i = 0; i < count; i++) {
      particles.push(new Particle(x, y));
    }
    rings.push(new RingBurst(x, y));
    rings.push(new RingBurst(x, y));
    rings[rings.length - 1].r = 8;
  }

  function loop() {
    ctx.clearRect(0, 0, W, H);

    for (let i = particles.length - 1; i >= 0; i--) {
      particles[i].update();
      particles[i].draw(ctx);
      if (particles[i].life <= 0) particles.splice(i, 1);
    }
    for (let i = rings.length - 1; i >= 0; i--) {
      rings[i].update();
      rings[i].draw(ctx);
      if (rings[i].life <= 0) rings.splice(i, 1);
    }
    requestAnimationFrame(loop);
  }
  loop();

  /* ── Heart click handler ── */
  const heartWrap = document.getElementById('heartWrap');
  const heartSvg  = document.getElementById('heartSvg');

  function onHeartActivate(e) {
    /* Determine click position */
    let cx, cy;
    if (e.touches && e.touches.length) {
      cx = e.touches[0].clientX;
      cy = e.touches[0].clientY;
    } else if (e.changedTouches && e.changedTouches.length) {
      cx = e.changedTouches[0].clientX;
      cy = e.changedTouches[0].clientY;
    } else {
      const r = heartWrap.getBoundingClientRect();
      cx = e.clientX || r.left + r.width / 2;
      cy = e.clientY || r.top  + r.height / 2;
    }

    burst(cx, cy);

    heartSvg.classList.remove('clicked');
    void heartSvg.offsetWidth;
    heartSvg.classList.add('clicked');
    heartSvg.addEventListener('animationend', () => heartSvg.classList.remove('clicked'), { once: true });

    showNextQuote();
  }

  heartWrap.addEventListener('click',      onHeartActivate);
  heartWrap.addEventListener('touchend',   onHeartActivate, { passive: true });
  heartWrap.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      onHeartActivate(e);
    }
  });

  /* Show first quote automatically after a gentle delay */
  setTimeout(showNextQuote, 1800);

})();
</script>
</body>
</html>
